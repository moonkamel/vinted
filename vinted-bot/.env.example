# Copie ce fichier en ".env" puis remplis MODE, la clé API (en mode ia) et le jeton Telegram.
# Ne partage jamais ce fichier : il contient tes clés.

# ia = analyse par Claude (lit les photos, payante) ; regles = règles fixes sans IA (gratuit)
MODE=ia
# En mode regles : lire les étiquettes sur les photos (OCR gratuit, local). on ou off
OCR=on

# Clé API Claude (console.anthropic.com → API Keys) : inutile en MODE=regles
ANTHROPIC_API_KEY=
# Jeton du 2e bot Telegram "analyste" (BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Optionnel : rempli tout seul quand tu envoies /start au bot analyste
TELEGRAM_CHAT_ID=

# buy   = seulement les achats immédiats sûrs (ACHETER + marge OK + authenticité probable + confiance suffisante)
# deals = aussi les "VÉRIFIER avant d'acheter" et les "OFFRE"
# all   = tout, y compris les PASSER
# (un lien que tu colles toi-même au bot est toujours analysé et envoyé)
NOTIFY=buy
# Pour NOTIFY=buy : confiance minimale de Claude, elevee (le plus strict) ou moyenne
MIN_CONFIDENCE=elevee
# claude-opus-5-5 (le plus fiable) ou claude-sonnet-5-5 (environ 2 fois moins cher)
CLAUDE_MODEL=claude-opus-5-5
# low, medium ou high : plus haut = plus réfléchi et plus cher
CLAUDE_EFFORT=medium
# Nombre de photos envoyées à Claude par annonce (plus = plus précis et plus cher)
MAX_PHOTOS=5
# Règle d'achat
MIN_MARGIN_EUR=8
MIN_MARGIN_PCT=40
VINTED_BASE_URL=https://www.vinted.fr

# Jeux de règles du mode "regles" (appareils photo + mode)
RULES_FILES=rules.json,rules-mode.json
# Les cartes Pokémon (rules-pokemon.json, prix TCGdex / Cardmarket) sont toujours chargées.
